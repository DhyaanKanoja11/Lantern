# Maintainer: Dhyaan Kanoja <https://github.com/DhyaanKanoja11>
pkgname=lantern-bin
pkgver=0.3.0
pkgrel=1
pkgdesc="Local-first developer security tool explaining configuration causality behind exposed services"
arch=('x86_64' 'aarch64')
url="https://github.com/DhyaanKanoja11/Lantern"
license=('MIT')
depends=('iproute2')
optdepends=('docker: for container and Compose correlation')
provides=('lantern')
conflicts=('lantern')

source_x86_64=("https://github.com/DhyaanKanoja11/Lantern/releases/download/v${pkgver}/lantern_${pkgver}_linux_amd64.tar.gz")
sha256sums_x86_64=('73de38fbd25ac3c2ede96b830abbbf59249572b5019b9e5b11b3d8d77a53a752')

source_aarch64=("https://github.com/DhyaanKanoja11/Lantern/releases/download/v${pkgver}/lantern_${pkgver}_linux_arm64.tar.gz")
sha256sums_aarch64=('4d40ff817b366aef7b446d5238c36cdd3708b545c47732f44ee1eb056a75b723')

package() {
    install -Dm755 "${srcdir}/lantern" "${pkgdir}/usr/bin/lantern"
    install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 "${srcdir}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
